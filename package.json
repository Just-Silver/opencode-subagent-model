{
  "name": "@justsilver/opencode-team",
  "version": "0.2.2-beta.4",
  "type": "module",
  "description": "Zero-config multi-agent team for OpenCode V2: Orchestrator, QA, Reviewer, and per-agent subagent model/variant policy",
  "license": "MIT",
  "author": "Just-Silver",
  "homepage": "https://github.com/Just-Silver/opencode-team#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Just-Silver/opencode-team.git"
  },
  "bugs": {
    "url": "https://github.com/Just-Silver/opencode-team/issues"
  },
  "keywords": ["opencode", "opencode-plugin", "agent", "team", "orchestrator", "subagent", "model"],
  "main": "./plugin/opencode-team/index.ts",
  "exports": {
    ".": "./plugin/opencode-team/index.ts",
    "./server": "./plugin/opencode-team/index.ts",
    "./tui": "./dist/tui.js",
    "./rpc": "./plugin/opencode-team/rpc.ts"
  },
  "files": ["plugin/**/*.ts", "plugin/**/*.tsx", "dist/**/*.js", "CHANGELOG.md"],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "build:prompts": "node scripts/build-prompts.mjs gen",
    "check:prompts": "node scripts/build-prompts.mjs check",
    "build:tui": "node scripts/build-tui.mjs",
    "bundle:check": "esbuild plugin/opencode-team/index.ts --bundle --platform=node --format=esm --outfile=dist/team-server.js && esbuild plugin/opencode-team/tui.ts --bundle --platform=node --format=esm --jsx=automatic --jsx-import-source=@opentui/solid --external:@opencode/plugin/tui --external:@opentui/core --external:@opentui/solid --external:solid-js --outfile=dist/team-tui.js",
    "prepack": "node scripts/build-prompts.mjs check && node scripts/build-tui.mjs"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.4 <0.9.0",
    "@opentui/solid": ">=0.8.4 <0.9.0",
    "solid-js": ">=1.9.12 <2"
  },
  "peerDependenciesMeta": {
    "@opentui/core": { "optional": true },
    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode/client": "^2.3.0",
    "@opencode/plugin": "^2.3.0",
    "@opencode/theme": "^2.3.0",
    "@opentui/core": "^0.8.4",
    "@opentui/solid": "^0.8.4",
    "babel-preset-solid": "^1.9.16",
    "esbuild": "^0.28.2",
    "solid-js": "^1.9.17",
    "typescript": "^5.9.3"
  }
}
